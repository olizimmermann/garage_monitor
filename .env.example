# Garage Monitor — environment configuration
# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored, so your real credentials never get committed.
#
# Every value here just seeds the defaults on first run; all of them can also be
# changed live from the dashboard's Settings tab (stored in data/config.json).

# ── Camera (required) ──────────────────────────────────────────────────────────
# Full RTSP stream URL, including credentials if your camera needs them.
RTSP_URL=rtsp://user:password@192.168.1.50/live0

# ── MQTT (optional — leave MQTT_BROKER blank to disable publishing) ─────────────
MQTT_BROKER=192.168.1.10
MQTT_PORT=1883
MQTT_USER=mqtt_user
MQTT_PASSWORD=changeme
MQTT_TOPIC=garage/status

# ── Monitor tuning (optional) ──────────────────────────────────────────────────
# Seconds between frame checks.
CHECK_INTERVAL=10
# Minimum SSIM score to trust a match; below it the door defaults to "open".
SSIM_THRESHOLD=0.4
# How many confidence readings to keep and plot on the dashboard chart.
SCORE_HISTORY_SIZE=60

# ── Dashboard login (optional, recommended on shared networks) ─────────────────
# Setting WEB_PASSWORD enables HTTP Basic auth for the UI, API and WebSocket.
WEB_USERNAME=admin
WEB_PASSWORD=

# ── AI second opinion via Ollama (optional) ────────────────────────────────────
# off | uncertain (ask only when SSIM can't decide) | verify (also double-check
# every switch to "closed"). Needs a vision-capable model.
LLM_MODE=off
LLM_URL=http://192.168.1.20:11434
LLM_MODEL=qwen3.5:2b
# Ignore model answers below this self-reported confidence (0–1).
LLM_MIN_CONFIDENCE=0.7
# Also ask when the closed/open SSIM scores are closer together than this.
LLM_MARGIN=0.05
# Seconds per request, including queueing on a shared server and a cold model load.
LLM_TIMEOUT=60
# How long Ollama keeps the model loaded afterwards (keep short on shared boxes).
LLM_KEEP_ALIVE=5m
